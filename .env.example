BOT_TOKEN=1234567890:AAExampleTokenReplaceMe
ADMIN_IDS=123456789
DB_PATH=data/stars_bot.sqlite3
BOT_USERNAME=
SUPPORT_CONTACT=@support
# Публичный канал, куда бот публикует заявки на вывод (бот должен быть админом)
WITHDRAW_CHANNEL=@YourPaymentChannel
# Каналы обязательной подписки перед использованием бота (@username или ссылки
# через запятую). Бот должен быть администратором этих каналов.
SPONSOR_CHANNELS=@YourSponsorChannel
# 1 — если ADMIN_IDS пуст, назначить админом владельца канала WITHDRAW_CHANNEL
# (запасной вариант: первый пользователь, нажавший /start)
BOOTSTRAP_FIRST_ADMIN=1

# API-ключи
FLYER_API_KEY=
TGRASS_API_KEY=
TGRASS_API_URL=https://tgrass.space
BOTOHUB_TOKEN=ваш_токен_от_botohub